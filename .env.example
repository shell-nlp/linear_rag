# 大模型配置
LLM_API_KEY=your-api-key
LLM_BASE_URL=http://your-llm-host:8080/v1
LLM_MODEL_NAME=your-chat-model

# Embedding 配置
EMBEDDING_API_URL=http://your-embedding-host:8080/v1/embeddings
EMBEDDING_MODEL_NAME=your-embedding-model
EMBEDDING_DIM=1024

# 文档处理和索引配置
SPACY_MODEL=zh_core_web_md
MAX_WORKERS=16
CHUNK_TOKEN_SIZE=1000
CHUNK_OVERLAP_TOKEN_SIZE=100
BATCH_SIZE=128
RETRIEVAL_TOP_K=5
MAX_ITERATIONS=3
TOP_K_SENTENCE=1
PASSAGE_RATIO=1.5
PASSAGE_NODE_WEIGHT=0.05
DAMPING=0.5
ITERATION_THRESHOLD=0.5
WORKING_DIR=./import_qwen_new

# Neo4j 配置
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# MinIO 配置
minio_service_addresses=your-minio-host:9000
minio_access_key=your-minio-access-key
minio_secret_key=your-minio-secret-key

# Elasticsearch 配置
es_url=http://your-elasticsearch-host:9200
es_user=elastic
es_password=your-elasticsearch-password

# Redis 配置
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SENTINEL_MASTER=
REDIS_SENTINEL_NODES=
